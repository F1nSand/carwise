# DeepSeek 配置 —— 填入你的 API Key 后即可启用 AI 解读
# 获取地址：https://platform.deepseek.com  （API Keys 页面）
DEEPSEEK_API_KEY=

# 以下可留默认
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 当前项目已验证的模型名；不要写成裸的 v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash

# 生产环境必须设置为随机高强度秘密（例如 `python -c "import secrets; print(secrets.token_hex(32))"`）
# APP_ENV=production
# OWNER_COOKIE_SECRET=
# 通过 HTTPS 部署时设为 true；生产部署会默认启用 Secure。
# OWNER_COOKIE_SECURE=true
# OWNER_COOKIE_MAX_AGE_S=2592000

# Docker production gateway: DNS must point to this host; expose ports 80/443.
# APP_DOMAIN=analysis.example.com
# APP_USERNAME=analyst
# Generate with: docker run --rm -it caddy:2-alpine caddy hash-password
# Quote the hash with single quotes so Compose preserves its dollar signs.
# APP_PASSWORD_HASH='$2a$...'
# Optional API token injected by the authenticated gateway; never send to Vite.
# APP_PUBLIC_ACCESS_TOKEN=
# Shared by migration and API. Relative paths are relative to the project root.
# RUNTIME_DATABASE_PATH=.cache/runtime.sqlite3
# Durable admission limits; 0 disables a limit in local development.
# Compose defaults: 128 globally, 16 per owner, 10,000,000 daily tokens.
# RUNTIME_MAX_PENDING_GLOBAL=128
# RUNTIME_MAX_PENDING_PER_OWNER=16
# RUNTIME_DAILY_TOKEN_LIMIT=10000000
# Fallback polling only; in-process SSE notifications remain immediate.
# RUNTIME_SSE_POLL_INTERVAL_SECONDS=2
# DataFrame cache budget, not a process RSS limit (default 512 MiB).
# DATASET_SNAPSHOT_CACHE_MAX_BYTES=536870912
